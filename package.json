{
  "name": "@local/mooncancer",
  "version": "1.0.0",
  "description": "MoonCancer (FGO automation) plugin for DeepSeek Harness: lets the agent supervise and control FGO automation through the MoonCancer local open API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwakinX/dsh-mooncancer.git"
  },
  "homepage": "https://github.com/SwakinX/dsh-mooncancer#readme",
  "bugs": "https://github.com/SwakinX/dsh-mooncancer/issues",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "files": [
    "src",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.png"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "mooncancer",
    "fgo"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
